# Copy this file to .env and add your Anthropic API key to enable AI refinement.
# Without a key the checker still runs every guideline rule and applies safe automatic fixes.
ANTHROPIC_API_KEY=
# Or a Google AI Studio key (used instead of Claude when set; AI_PROVIDER=anthropic forces Claude)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# Optional
# COMMS_MODEL=claude-opus-5-5
# PORT=3000
